{
  "name": "mehh",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:mehh": "cross-env NODE_OPTIONS=--no-deprecation NEXT_PUBLIC_SERVER_URL=http://mehh.test:3000 next dev -H mehh.test -p 3000",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "migrate": "pnpm payload migrate",
    "migrate:create": "pnpm payload migrate:create",
    "migrate:status": "pnpm payload migrate:status",
    "migrate:remote": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate",
    "migrate:status:remote": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate:status",
    "database:optimize:remote": "wrangler d1 execute D1 --command 'PRAGMA optimize' --remote",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "prebuild": "pnpm generate:importmap && pnpm generate:types:payload",
    "deploy": "pnpm run deploy:app",
    "deploy:app": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --rclone --cacheChunkSize 10",
    "wrangler:login": "pnpm exec wrangler login"
  },
  "dependencies": {
    "@next/third-parties": "16.3.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@payloadcms/admin-bar": "3.88.0",
    "@payloadcms/db-d1-sqlite": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-form-builder": "3.88.0",
    "@payloadcms/plugin-nested-docs": "3.88.0",
    "@payloadcms/plugin-redirects": "3.88.0",
    "@payloadcms/plugin-search": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-r2": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.2",
    "lucide-react": "^0.556.0",
    "next": "16.3.0",
    "nodemailer": "9.0.5",
    "payload": "3.88.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/escape-html": "^1.0.2",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "rclone.js": "0.6.6",
    "tailwindcss": "^3.4.3",
    "typescript": "5.7.3",
    "wrangler": "4.121.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rclone.js",
      "sharp",
      "unrs-resolver"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
